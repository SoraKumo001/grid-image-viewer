<UserControl
    x:Class="grid_image_viewer.Controls.SettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RequestedTheme="Dark"
    KeyDown="Overlay_KeyDown">

    <Grid Background="#01000000">
        <StackPanel
            Spacing="16"
            Padding="24"
            Background="#FF202020"
            CornerRadius="8"
            BorderBrush="#FF404040"
            BorderThickness="1"
            Width="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock x:Uid="Settings_Title" Text="Save Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White" />

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_JpegQuality" Text="JPEG/WebP Quality" FontWeight="SemiBold" Foreground="White" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderQuality" Minimum="1" Maximum="100" StepFrequency="1" />
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderQuality, Path=Value}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White" />
                </Grid>
            </StackPanel>

            <Button x:Name="BtnClose" x:Uid="ToneAdjustment_Close" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</UserControl>
