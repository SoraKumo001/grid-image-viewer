<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="grid_image_viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:grid_image_viewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Title="Grid Image Viewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid" x:FieldModifier="internal"
        AllowDrop="True"
        IsTabStop="True"
        KeyDown="RootGrid_KeyDown"
        DoubleTapped="RootGrid_DoubleTapped"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerWheelChanged="RootGrid_PointerWheelChanged"
        Background="#1A1A1A"
        RequestedTheme="Dark">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" x:FieldModifier="internal" Grid.Row="0" Height="32" Background="#242424" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <TextBlock x:Uid="AppTitleBar_Text" Text="Grid Image Viewer" Foreground="#888888" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Border>

        <ScrollViewer
            Grid.Row="1"
            x:Name="ImageScrollViewer" x:FieldModifier="internal"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="10.0">
            <Grid x:Name="PagesGrid" x:FieldModifier="internal"
                  Width="{Binding ElementName=ImageScrollViewer, Path=ViewportWidth}"
                  Height="{Binding ElementName=ImageScrollViewer, Path=ViewportHeight}"
                  Background="Transparent"
                  PointerPressed="PagesGrid_PointerPressed" 
                  PointerMoved="PagesGrid_PointerMoved" 
                  PointerReleased="PagesGrid_PointerReleased"
                  PointerCanceled="PagesGrid_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="Col0" x:FieldModifier="internal"/>
                    <ColumnDefinition Width="*" x:Name="Col1" x:FieldModifier="internal"/>
                    <ColumnDefinition Width="*" x:Name="Col2" x:FieldModifier="internal"/>
                    <ColumnDefinition Width="*" x:Name="Col3" x:FieldModifier="internal"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" x:Name="Row0" x:FieldModifier="internal"/>
                    <RowDefinition Height="*" x:Name="Row1" x:FieldModifier="internal"/>
                </Grid.RowDefinitions>

                <Grid x:Name="PageGrid4" x:FieldModifier="internal" Visibility="Collapsed">
                    <Grid x:Name="PrevContainer4" x:FieldModifier="internal" IsHitTestVisible="False">
                        <Image x:Name="Image4_Prev" x:FieldModifier="internal" Stretch="Uniform" />
                    </Grid>
                    <Grid x:Name="CurrentContainer4" x:FieldModifier="internal">
                        <Image x:Name="Image4" x:FieldModifier="internal" Stretch="Uniform" />
                        <skia:SKXamlCanvas x:Name="Canvas4" x:FieldModifier="internal" Visibility="Collapsed" PaintSurface="Canvas4_PaintSurface" />
                    </Grid>
                    <ProgressRing x:Name="LoadingRing4" x:FieldModifier="internal" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Grid x:Name="PageGrid3" x:FieldModifier="internal" Visibility="Collapsed">
                    <Grid x:Name="PrevContainer3" x:FieldModifier="internal" IsHitTestVisible="False">
                        <Image x:Name="Image3_Prev" x:FieldModifier="internal" Stretch="Uniform" />
                    </Grid>
                    <Grid x:Name="CurrentContainer3" x:FieldModifier="internal">
                        <Image x:Name="Image3" x:FieldModifier="internal" Stretch="Uniform" />
                        <skia:SKXamlCanvas x:Name="Canvas3" x:FieldModifier="internal" Visibility="Collapsed" PaintSurface="Canvas3_PaintSurface" />
                    </Grid>
                    <ProgressRing x:Name="LoadingRing3" x:FieldModifier="internal" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Grid x:Name="PageGrid2" x:FieldModifier="internal" Visibility="Collapsed">
                    <Grid x:Name="PrevContainer2" x:FieldModifier="internal" IsHitTestVisible="False">
                        <Image x:Name="Image2_Prev" x:FieldModifier="internal" Stretch="Uniform" />
                    </Grid>
                    <Grid x:Name="CurrentContainer2" x:FieldModifier="internal">
                        <Image x:Name="Image2" x:FieldModifier="internal" Stretch="Uniform" />
                        <skia:SKXamlCanvas x:Name="Canvas2" x:FieldModifier="internal" Visibility="Collapsed" PaintSurface="Canvas2_PaintSurface" />
                    </Grid>
                    <ProgressRing x:Name="LoadingRing2" x:FieldModifier="internal" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Grid x:Name="PageGrid1" x:FieldModifier="internal" Visibility="Collapsed">
                    <Grid x:Name="PrevContainer1" x:FieldModifier="internal" IsHitTestVisible="False">
                        <Image x:Name="Image1_Prev" x:FieldModifier="internal" Stretch="Uniform" />
                    </Grid>
                    <Grid x:Name="CurrentContainer1" x:FieldModifier="internal">
                        <Image x:Name="Image1" x:FieldModifier="internal" Stretch="Uniform" />
                        <skia:SKXamlCanvas x:Name="Canvas1" x:FieldModifier="internal" Visibility="Collapsed" PaintSurface="Canvas1_PaintSurface" />
                    </Grid>
                    <ProgressRing x:Name="LoadingRing1" x:FieldModifier="internal" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Grid Grid.ColumnSpan="4" Grid.RowSpan="2" x:Name="OverlayGrid" x:FieldModifier="internal" Background="Transparent" IsHitTestVisible="False">
                    <Canvas x:Name="OverlayCanvas" x:FieldModifier="internal" Background="Transparent" IsHitTestVisible="True">
                        <Rectangle x:Name="SelectionRectangle" x:FieldModifier="internal" Stroke="CornflowerBlue" StrokeThickness="2" Fill="#446495ED" Visibility="Collapsed" />
                    </Canvas>

                    <!-- Metadata Overlay Panel -->
                    <Border x:Name="MetadataPanel" x:FieldModifier="internal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,20,20,0"
                            Background="#CC000000" CornerRadius="8" Padding="16"
                            Visibility="Collapsed" MaxWidth="350" IsHitTestVisible="True">
                        <StackPanel Spacing="4">
                            <TextBlock Text="IMAGE INFORMATION" FontSize="10" Foreground="#888888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMetaFileName" x:FieldModifier="internal" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtMetaDimensions" x:FieldModifier="internal" Foreground="#00A2ED" FontSize="12"/>
                            <TextBlock x:Name="TxtMetaFileSize" x:FieldModifier="internal" Foreground="#AAAAAA" FontSize="12"/>
                            
                            <Border x:Name="ExifDivider" x:FieldModifier="internal" Height="1" Background="#333333" Margin="0,8"/>
                            
                            <Grid x:Name="ExifGrid" x:FieldModifier="internal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                                <TextBlock x:Name="TxtMetaCamera" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lens" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                                <TextBlock x:Name="TxtMetaLens" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Settings" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                                <TextBlock x:Name="TxtMetaSettings" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1" Foreground="#FFD700" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Date" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                                <TextBlock x:Name="TxtMetaDate" x:FieldModifier="internal" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid.ContextFlyout>
                    <MenuFlyout x:Name="EditMenuFlyout" Opening="EditMenuFlyout_Opening">
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="Transitions">
                                    <Setter.Value>
                                        <TransitionCollection />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                        <MenuFlyoutItem x:Name="MenuUndo" x:FieldModifier="internal" x:Uid="MenuUndo" Text="Undo" Click="MenuUndo_Click" />
                        <MenuFlyoutItem x:Name="MenuRedo" x:FieldModifier="internal" x:Uid="MenuRedo" Text="Redo" Click="MenuRedo_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="MenuSaveAs" x:FieldModifier="internal" x:Uid="MenuSaveAs" Text="Save As...">
                            <MenuFlyoutItem Text="JPEG" Click="MenuSaveAs_Click" Tag=".jpg" />
                            <MenuFlyoutItem Text="PNG" Click="MenuSaveAs_Click" Tag=".png" />
                            <MenuFlyoutItem Text="WebP" Click="MenuSaveAs_Click" Tag=".webp" />
                            <MenuFlyoutItem Text="BMP" Click="MenuSaveAs_Click" Tag=".bmp" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Name="MenuOverwrite" x:FieldModifier="internal" x:Uid="MenuOverwrite" Text="Overwrite" Click="MenuOverwrite_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuCrop" x:FieldModifier="internal" x:Uid="MenuCrop" Text="Crop (Selection)" Click="MenuCrop_Click" IsEnabled="False" />
                        <MenuFlyoutItem x:Name="MenuResize" x:FieldModifier="internal" x:Uid="MenuResize" Text="Resize" Click="MenuResize_Click" />
                        <MenuFlyoutSubItem x:Name="MenuRotate" x:FieldModifier="internal" x:Uid="MenuRotate" Text="Rotate">
                            <MenuFlyoutItem x:Uid="MenuRotate_Right90" Text="Rotate Right 90°" Click="MenuRotate_Click" Tag="90" />
                            <MenuFlyoutItem x:Uid="MenuRotate_Left90" Text="Rotate Left 90°" Click="MenuRotate_Click" Tag="-90" />
                            <MenuFlyoutItem x:Uid="MenuRotate_180" Text="Rotate 180°" Click="MenuRotate_Click" Tag="180" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Name="MenuFlip" x:FieldModifier="internal" x:Uid="MenuFlip" Text="Flip">
                            <MenuFlyoutItem x:Uid="MenuFlip_Horz" Text="Flip Horizontal" Click="MenuFlip_Click" Tag="Horz" />
                            <MenuFlyoutItem x:Uid="MenuFlip_Vert" Text="Flip Vertical" Click="MenuFlip_Click" Tag="Vert" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuTone" x:FieldModifier="internal" x:Uid="MenuTone" Text="Tone Adjustment" Click="MenuTone_Click" />
                        <MenuFlyoutSubItem x:Name="MenuFilter" x:FieldModifier="internal" x:Uid="MenuFilter" Text="Filters">
                            <MenuFlyoutItem x:Uid="MenuFilter_Grayscale" Text="Grayscale" Click="MenuFilter_Click" Tag="Grayscale" />
                            <MenuFlyoutItem x:Uid="MenuFilter_Sepia" Text="Sepia" Click="MenuFilter_Click" Tag="Sepia" />
                            <MenuFlyoutItem x:Uid="MenuFilter_Invert" Text="Negative/Positive" Click="MenuFilter_Click" Tag="Invert" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuOpenExplorer" x:FieldModifier="internal" x:Uid="MenuOpenExplorer" Text="Open in Explorer" Click="MenuOpenExplorer_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="MenuViewMode" x:FieldModifier="internal" x:Uid="MenuViewMode" Text="View Mode">
                            <ToggleMenuFlyoutItem x:Name="MenuViewSingle" x:FieldModifier="internal" x:Uid="MenuViewMode_Single" Text="Single" Click="MenuViewMode_Click" Tag="1" />
                            <ToggleMenuFlyoutItem x:Name="MenuViewDouble" x:FieldModifier="internal" x:Uid="MenuViewMode_Double" Text="Manga (2-split)" Click="MenuViewMode_Click" Tag="2" />
                            <ToggleMenuFlyoutItem x:Name="MenuViewQuad" x:FieldModifier="internal" x:Uid="MenuViewMode_Quad" Text="Quad (4-split)" Click="MenuViewMode_Click" Tag="4" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Name="MenuQuadLayout" x:FieldModifier="internal" x:Uid="MenuQuadLayout" Text="Quad Layout">
                            <ToggleMenuFlyoutItem x:Name="MenuLayoutAuto" x:FieldModifier="internal" x:Uid="MenuLayoutAuto" Text="Auto (Aspect Ratio)" Click="MenuLayoutMode_Click" Tag="0" />
                            <ToggleMenuFlyoutItem x:Name="MenuLayoutHorz" x:FieldModifier="internal" x:Uid="MenuLayoutHorz" Text="Horizontal (1x4)" Click="MenuLayoutMode_Click" Tag="1" />
                            <ToggleMenuFlyoutItem x:Name="MenuLayoutGrid" x:FieldModifier="internal" x:Uid="MenuLayoutGrid" Text="Grid (2x2)" Click="MenuLayoutMode_Click" Tag="2" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuSettings" x:FieldModifier="internal" x:Uid="MenuSettings" Text="Settings..." Click="MenuSettings_Click" />
                        <MenuFlyoutItem x:Name="MenuKeyBindings" x:FieldModifier="internal" x:Uid="MenuKeyBindings" Text="Key Bindings Settings..." Click="MenuKeyBindings_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </ScrollViewer>

        <!-- Grid Mode UI -->
        <GridView x:Name="ImageGridView" x:FieldModifier="internal"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ImageGridView_ItemClick"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  SizeChanged="ImageGridView_SizeChanged"
                  Margin="10">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ImageItem">
                    <Grid Margin="5" CornerRadius="4" Background="#333333" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                        <Border VerticalAlignment="Bottom" Background="#88000000" Padding="4">
                            <TextBlock Text="{x:Bind FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                        </Border>
                        <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="32" Height="32" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        
        <!-- Folder Searching Overlay -->
            <Border x:Name="FolderSearchingOverlay" x:FieldModifier="internal" Grid.Row="1" Background="#88000000" Visibility="Collapsed" IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="64" Height="64" Foreground="#00A2ED" />
                    <TextBlock x:Uid="SearchingText" Text="Searching for images..." Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Notification Overlay -->
            <Border x:Name="NotificationOverlay" x:FieldModifier="internal" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80" Padding="40,24" Background="#CC000000" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="NotificationText" x:FieldModifier="internal" Foreground="White" FontSize="36" FontWeight="Bold" />
            </Border>
        
        <ContentDialog x:Name="SlideshowDialog" x:FieldModifier="internal" x:Uid="SlideshowDialog"
                       Title="自動再生設定"
                       PrimaryButtonText="OK"
                       CloseButtonText="キャンセル"
                       DefaultButton="Primary"
                       PrimaryButtonClick="SlideshowDialog_PrimaryButtonClick"
                       Opened="SlideshowDialog_Opened">
            <StackPanel Spacing="12">
                <CheckBox x:Name="SlideshowFullscreen" x:FieldModifier="internal" x:Uid="SlideshowFullscreen" Content="全画面表示(_F)"/>
                <CheckBox x:Name="SlideshowRandom" x:FieldModifier="internal" x:Uid="SlideshowRandom" Content="ランダムな並び順(_R)"/>
                <CheckBox x:Name="SlideshowLoop" x:FieldModifier="internal" x:Uid="SlideshowLoop" Content="ループする(_L)"/>
                <CheckBox x:Name="SlideshowNextFolder" x:FieldModifier="internal" x:Uid="SlideshowNextFolder" Content="次のフォルダも表示(_N)"/>
                <CheckBox x:Name="SlideshowIncludeSiblings" x:FieldModifier="internal" Content="兄弟フォルダも対象にする(_S)"/>
                <CheckBox x:Name="SlideshowCurrentFolderOnly" x:FieldModifier="internal" x:Uid="SlideshowCurrentFolderOnly" Content="下位フォルダも含める(_B)"/>
                <CheckBox x:Name="SlideshowUniformToFill" x:FieldModifier="internal" x:Uid="SlideshowUniformToFill" Content="拡大して全体を埋める(_C)"/>
                <CheckBox x:Name="SlideshowCrossfade" x:FieldModifier="internal" Content="クロスフェードを有効にする"/>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SlideshowIntervalLabel" Text="時間(_T)：" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" x:Name="SlideshowInterval" x:FieldModifier="internal" SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1.0" Minimum="0.1" Margin="4,0" HorizontalAlignment="Left" Width="120"/>
                        <TextBlock Grid.Column="2" x:Uid="SlideshowIntervalUnit" Text="秒毎" VerticalAlignment="Center" Width="40"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="フェード時間：" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" x:Name="SlideshowCrossfadeDuration" x:FieldModifier="internal" SpinButtonPlacementMode="Inline" SmallChange="0.05" LargeChange="0.1" Minimum="0" Maximum="5" Margin="4,0" HorizontalAlignment="Left" Width="120"/>
                        <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Width="40"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
