<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="grid_image_viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:grid_image_viewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Title="Grid Image Viewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        IsTabStop="True"
        KeyDown="RootGrid_KeyDown"
        DoubleTapped="RootGrid_DoubleTapped"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerWheelChanged="RootGrid_PointerWheelChanged"
        Background="#1A1A1A"
        RequestedTheme="Dark">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="#242424" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <TextBlock Text="Grid Image Viewer" Foreground="#888888" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Border>

        <ScrollViewer
            Grid.Row="1"
            x:Name="ImageScrollViewer"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="10.0">
            <Grid x:Name="PagesGrid" 
                  Width="{Binding ElementName=ImageScrollViewer, Path=ViewportWidth}"
                  Height="{Binding ElementName=ImageScrollViewer, Path=ViewportHeight}"
                  RightTapped="PagesGrid_RightTapped" 
                  PointerPressed="PagesGrid_PointerPressed" 
                  PointerMoved="PagesGrid_PointerMoved" 
                  PointerReleased="PagesGrid_PointerReleased"
                  PointerCanceled="PagesGrid_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" x:Name="LeftColumn"/>
                    <ColumnDefinition Width="*" x:Name="RightColumn"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="LeftPageGrid" Visibility="Collapsed">
                    <Image x:Name="LeftImage" Stretch="Uniform" HorizontalAlignment="Right" />
                    <skia:SKXamlCanvas x:Name="LeftSkiaCanvas" Visibility="Collapsed" PaintSurface="LeftSkiaCanvas_PaintSurface" />
                    <ProgressRing x:Name="LeftLoadingRing" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Grid Grid.Column="1" x:Name="RightPageGrid">
                    <Image x:Name="RightImage" Stretch="Uniform" />
                    <skia:SKXamlCanvas x:Name="RightSkiaCanvas" Visibility="Collapsed" PaintSurface="RightSkiaCanvas_PaintSurface" />
                    <ProgressRing x:Name="RightLoadingRing" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                </Grid>

                <Canvas Grid.ColumnSpan="2" x:Name="OverlayCanvas" Background="Transparent">
                    <Rectangle x:Name="SelectionRectangle" Stroke="CornflowerBlue" StrokeThickness="2" Fill="#446495ED" Visibility="Collapsed" />
                </Canvas>

                <Grid.ContextFlyout>
                    <MenuFlyout x:Name="EditMenuFlyout" Opening="EditMenuFlyout_Opening">
                        <MenuFlyoutSubItem Text="Save As...">
                            <MenuFlyoutItem Text="JPEG" Click="MenuSaveAs_Click" Tag=".jpg" />
                            <MenuFlyoutItem Text="PNG" Click="MenuSaveAs_Click" Tag=".png" />
                            <MenuFlyoutItem Text="WebP" Click="MenuSaveAs_Click" Tag=".webp" />
                            <MenuFlyoutItem Text="BMP" Click="MenuSaveAs_Click" Tag=".bmp" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="Overwrite" Click="MenuOverwrite_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuCrop" Text="Crop (Selection)" Click="MenuCrop_Click" IsEnabled="False" />
                        <MenuFlyoutItem Text="Resize" Click="MenuResize_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open in Explorer" Click="MenuOpenExplorer_Click" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="MenuToggleManga" Text="Manga Mode" Click="MenuToggleManga_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Key Bindings Settings..." Click="MenuKeyBindings_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </ScrollViewer>

        <!-- Grid Mode UI -->
        <GridView x:Name="ImageGridView"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ImageGridView_ItemClick"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  SizeChanged="ImageGridView_SizeChanged"
                  Margin="10">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ImageItem">
                    <Grid Margin="5" CornerRadius="4" Background="#333333" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                        <Border VerticalAlignment="Bottom" Background="#88000000" Padding="4">
                            <TextBlock Text="{x:Bind FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                        </Border>
                        <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="32" Height="32" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        
        <!-- Folder Searching Overlay -->
            <Border x:Name="FolderSearchingOverlay" Grid.Row="1" Background="#88000000" Visibility="Collapsed" IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="64" Height="64" Foreground="#00A2ED" />
                    <TextBlock Text="Searching for images..." Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Notification Overlay -->
            <Border x:Name="NotificationOverlay" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,24" Background="#CC000000" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="NotificationText" Foreground="White" FontSize="36" FontWeight="Bold" />
            </Border>
        
        <ContentDialog x:Name="SlideshowDialog"
                       Title="自動再生設定"
                       PrimaryButtonText="OK"
                       CloseButtonText="キャンセル"
                       PrimaryButtonClick="SlideshowDialog_PrimaryButtonClick">
            <StackPanel Spacing="12">
                <CheckBox x:Name="SlideshowFullscreen" Content="全画面表示(_F)"/>
                <CheckBox x:Name="SlideshowRandom" Content="ランダムな並び順(_R)"/>
                <CheckBox x:Name="SlideshowLoop" Content="ループする(_L)"/>
                <CheckBox x:Name="SlideshowNextFolder" Content="次のフォルダも表示(_N)"/>
                <CheckBox x:Name="SlideshowCurrentFolderOnly" Content="開始フォルダと下位フォルダだけ表示(_B)" IsEnabled="False"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="時間(_T)：" VerticalAlignment="Center"/>
                    <NumberBox x:Name="SlideshowInterval" SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1.0" Minimum="0.1" Width="120"/>
                    <TextBlock Text="秒毎" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
