<UserControl
    x:Class="quick_image_viewer.Views.Controls.WelcomePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#1A1A1A">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <Viewbox Width="120" Height="120" Opacity="0.1">
                <SymbolIcon Symbol="Pictures" Foreground="White" />
            </Viewbox>
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Uid="WelcomePanel_Title" Text="No images loaded" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Uid="WelcomePanel_Instruction" Text="Drag &amp; drop a folder here, or open one using the button below" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>
            <Button x:Uid="WelcomePanel_OpenButton" HorizontalAlignment="Center" Padding="32,12" 
                    Style="{StaticResource AccentButtonStyle}" Click="OpenFolderButton_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" />
                        <TextBlock x:Uid="WelcomePanel_OpenButtonText" Text="Open Folder" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>