<UserControl
    x:Class="quick_image_viewer.Views.Controls.GridImagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:quick_image_viewer.Views.Controls"
    xmlns:models="using:quick_image_viewer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <GridView x:Name="ImageGridView"
              SelectionMode="Single"
              IsItemClickEnabled="True"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="10">
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="models:ImageItem">
                <Grid Margin="5" CornerRadius="4" Background="#333333" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                    <Border VerticalAlignment="Bottom" Background="#88000000" Padding="4">
                        <TextBlock Text="{x:Bind FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                    </Border>
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="32" Height="32" Foreground="#00A2ED" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60" />
                </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>