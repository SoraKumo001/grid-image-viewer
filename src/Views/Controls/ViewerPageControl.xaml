<UserControl
    x:Class="quick_image_viewer.Views.Controls.ViewerPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:quick_image_viewer.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d">

    <Grid x:Name="InternalRootGrid">
        <Image x:Name="InternalPageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <skia:SKXamlCanvas x:Name="InternalPageCanvas" Visibility="Collapsed" />
        <ProgressRing x:Name="InternalLoadingRing" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100" IsActive="False" />
        <Border x:Name="InternalFocusBorder" BorderBrush="#00A2ED" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>