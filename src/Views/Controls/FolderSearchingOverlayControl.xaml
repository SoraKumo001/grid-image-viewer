<UserControl
    x:Class="quick_image_viewer.Views.Controls.FolderSearchingOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" IsHitTestVisible="False" IsTabStop="False">

    <Border Background="#CC000000" IsTabStop="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <ProgressRing IsActive="True" Width="64" Height="64" Foreground="#00A2ED" />
            <TextBlock x:Uid="SearchingText" Text="Searching for images..." Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>