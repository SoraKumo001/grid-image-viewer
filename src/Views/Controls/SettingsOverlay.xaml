<UserControl
    x:Class="quick_image_viewer.Views.Controls.SettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RequestedTheme="Dark"
    KeyDown="Overlay_KeyDown">

    <Grid Background="#01000000">
        <StackPanel
            Spacing="16"
            Padding="24"
            Background="#FF202020"
            CornerRadius="8"
            BorderBrush="#FF404040"
            BorderThickness="1"
            Width="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock x:Uid="Settings_Title" Text="General Settings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White" />

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_JpegQuality" Text="JPEG/WebP Quality" FontWeight="SemiBold" Foreground="White" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderQuality" Minimum="1" Maximum="100" StepFrequency="1" />
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderQuality, Path=Value}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Background" Text="Background Color" FontWeight="SemiBold" Foreground="White" />
                <ComboBox x:Name="ComboBackground" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_Background_System" Content="System (Mica)" />
                    <ComboBoxItem x:Uid="Settings_Background_Black" Content="Black" />
                    <ComboBoxItem x:Uid="Settings_Background_White" Content="White" />
                </ComboBox>
            </StackPanel>

            <CheckBox x:Name="CheckHighQuality" x:Uid="Settings_HighQuality" Content="High Quality Scaling" Foreground="White" />
            <CheckBox x:Name="CheckShowPageIndicator" x:Uid="Settings_ShowPageIndicator" Content="Show Page Count" Foreground="White" />

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_BoundaryAction" Text="Boundary Action (Start/End)" FontWeight="SemiBold" Foreground="White" />
                <ComboBox x:Name="ComboBoundary" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_BoundaryAction_None" Content="Do Nothing" />
                    <ComboBoxItem x:Uid="Settings_BoundaryAction_NextFolder" Content="Next Folder" />
                    <ComboBoxItem x:Uid="Settings_BoundaryAction_Loop" Content="Loop" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Extensions" Text="Enabled File Extensions" FontWeight="SemiBold" Foreground="White" />
                <ScrollViewer MaxHeight="120" BorderBrush="#FF404040" BorderThickness="1" Padding="4">
                    <ItemsControl x:Name="ItemsExtensions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="White" MinHeight="32" Padding="8,0,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Grid ColumnSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnExport" x:Uid="Settings_Export" Content="Export Settings" HorizontalAlignment="Stretch" Click="BtnExport_Click" />
                <Button x:Name="BtnImport" x:Uid="Settings_Import" Grid.Column="1" Content="Import Settings" HorizontalAlignment="Stretch" Click="BtnImport_Click" />
            </Grid>

            <Button x:Name="BtnClose" x:Uid="ToneAdjustment_Close" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</UserControl>
