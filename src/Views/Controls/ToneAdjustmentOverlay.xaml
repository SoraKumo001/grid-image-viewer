<UserControl
    x:Class="quick_image_viewer.Views.Controls.ToneAdjustmentOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RequestedTheme="Dark"
    KeyDown="Overlay_KeyDown">

    <Grid Background="#01000000">
        <StackPanel
            Spacing="16"
            Padding="24"
            Background="#FF202020"
            CornerRadius="8"
            BorderBrush="#FF404040"
            BorderThickness="1"
            Width="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock x:Uid="ToneAdjustment_Title" Text="Tone Adjustment" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White" />

            <StackPanel Spacing="4">
                <TextBlock x:Uid="ToneAdjustment_Brightness" Text="Brightness" FontWeight="SemiBold" Foreground="White" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderBrightness" Minimum="-255" Maximum="255" Value="0" StepFrequency="1" ValueChanged="OnValueChanged" />
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderBrightness, Path=Value}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="ToneAdjustment_Contrast" Text="Contrast" FontWeight="SemiBold" Foreground="White" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderContrast" Minimum="0" Maximum="2" Value="1" StepFrequency="0.01" ValueChanged="OnValueChanged" />
                    <TextBlock x:Name="TextContrast" Grid.Column="1" Text="1.00" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="ToneAdjustment_Saturation" Text="Saturation" FontWeight="SemiBold" Foreground="White" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderSaturation" Minimum="0" Maximum="2" Value="1" StepFrequency="0.01" ValueChanged="OnValueChanged" />
                    <TextBlock x:Name="TextSaturation" Grid.Column="1" Text="1.00" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button x:Uid="ToneAdjustment_Reset" Content="Reset" Width="80" Click="BtnReset_Click" />
                <Button x:Name="BtnClose" x:Uid="ToneAdjustment_Close" Content="Close" Width="80" Style="{StaticResource AccentButtonStyle}" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
