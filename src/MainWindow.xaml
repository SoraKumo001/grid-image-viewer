<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="quick_image_viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:quick_image_viewer"
    xmlns:managers="using:quick_image_viewer.Managers"
    xmlns:models="using:quick_image_viewer.Models"
    xmlns:viewmodels="using:quick_image_viewer.ViewModels"
    xmlns:controls="using:quick_image_viewer.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Title="Quick Image Viewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>


    <Grid
        x:Name="RootGrid" x:FieldModifier="internal"
        AllowDrop="True"
        IsTabStop="True"
        KeyDown="RootGrid_KeyDown"
        DoubleTapped="RootGrid_DoubleTapped"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerWheelChanged="RootGrid_PointerWheelChanged"
        SizeChanged="RootGrid_SizeChanged"
        RightTapped="RootGrid_RightTapped"
        PointerMoved="RootGrid_PointerMoved"
        Background="#1A1A1A"
        RequestedTheme="Dark">
        
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="EditMenuFlyout" Opening="EditMenuFlyout_Opening">
                <MenuFlyout.MenuFlyoutPresenterStyle>
                    <Style TargetType="MenuFlyoutPresenter">
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <TransitionCollection />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuFlyout.MenuFlyoutPresenterStyle>
                <MenuFlyoutItem x:Name="MenuUndo" x:FieldModifier="internal" x:Uid="MenuUndo" Text="Undo" Click="MenuUndo_Click" />
                <MenuFlyoutItem x:Name="MenuRedo" x:FieldModifier="internal" x:Uid="MenuRedo" Text="Redo" Click="MenuRedo_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="MenuBookmarksSub" x:FieldModifier="internal" x:Uid="MenuBookmarksSub" Text="Bookmarks">
                    <MenuFlyoutItem x:Name="MenuBookmark" x:FieldModifier="internal" x:Uid="MenuBookmark" Text="Bookmark this folder" Click="MenuBookmark_Click" />
                    <ToggleMenuFlyoutItem x:Name="MenuBookmarksToggle" x:FieldModifier="internal" x:Uid="MenuBookmarksToggle" Text="Show Bookmark Panel" Click="MenuBookmarksToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="MenuBookmarkList" x:FieldModifier="internal" x:Uid="MenuBookmarkList" Text="Bookmark List">
                        <!-- Dynamically populated -->
                    </MenuFlyoutSubItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="MenuSaveAs" x:FieldModifier="internal" x:Uid="MenuSaveAs" Text="Save As...">
                    <MenuFlyoutItem Text="JPEG" Click="MenuSaveAs_Click" Tag=".jpg" />
                    <MenuFlyoutItem Text="PNG" Click="MenuSaveAs_Click" Tag=".png" />
                    <MenuFlyoutItem Text="WebP" Click="MenuSaveAs_Click" Tag=".webp" />
                    <MenuFlyoutItem Text="BMP" Click="MenuSaveAs_Click" Tag=".bmp" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="MenuOverwrite" x:FieldModifier="internal" x:Uid="MenuOverwrite" Text="Overwrite" Click="MenuOverwrite_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuPrint" x:FieldModifier="internal" x:Uid="MenuPrint" Text="Print" Click="MenuPrint_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuCrop" x:FieldModifier="internal" x:Uid="MenuCrop" Text="Crop (Selection)" Click="MenuCrop_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Name="MenuResize" x:FieldModifier="internal" x:Uid="MenuResize" Text="Resize" Click="MenuResize_Click" />
                <MenuFlyoutSubItem x:Name="MenuRotate" x:FieldModifier="internal" x:Uid="MenuRotate" Text="Rotate">
                    <MenuFlyoutItem x:Uid="MenuRotate_Right90" Text="Rotate Right 90°" Click="MenuRotate_Click" Tag="90" />
                    <MenuFlyoutItem x:Uid="MenuRotate_Left90" Text="Rotate Left 90°" Click="MenuRotate_Click" Tag="-90" />
                    <MenuFlyoutItem x:Uid="MenuRotate_180" Text="Rotate 180°" Click="MenuRotate_Click" Tag="180" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MenuFlip" x:FieldModifier="internal" x:Uid="MenuFlip" Text="Flip">
                    <MenuFlyoutItem x:Uid="MenuFlip_Horz" Text="Flip Horizontal" Click="MenuFlip_Click" Tag="Horz" />
                    <MenuFlyoutItem x:Uid="MenuFlip_Vert" Text="Flip Vertical" Click="MenuFlip_Click" Tag="Vert" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuTone" x:FieldModifier="internal" x:Uid="MenuTone" Text="Tone Adjustment" Click="MenuTone_Click" />
                <MenuFlyoutSubItem x:Name="MenuFilter" x:FieldModifier="internal" x:Uid="MenuFilter" Text="Filters">
                    <MenuFlyoutItem x:Uid="MenuFilter_Grayscale" Text="Grayscale" Click="MenuFilter_Click" Tag="Grayscale" />
                    <MenuFlyoutItem x:Uid="MenuFilter_Sepia" Text="Sepia" Click="MenuFilter_Click" Tag="Sepia" />
                    <MenuFlyoutItem x:Uid="MenuFilter_Invert" Text="Negative/Positive" Click="MenuFilter_Click" Tag="Invert" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuOpenExplorer" x:FieldModifier="internal" x:Uid="MenuOpenExplorer" Text="Open in Explorer" Click="MenuOpenExplorer_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="MenuViewMode" x:FieldModifier="internal" x:Uid="MenuViewMode" Text="View Mode">
                    <ToggleMenuFlyoutItem x:Name="MenuMetadata" x:FieldModifier="internal" x:Uid="MenuMetadata" Text="Show Image Information" Click="MenuMetadata_Click" />
                    <ToggleMenuFlyoutItem x:Name="MenuPageIndicatorToggle" x:FieldModifier="internal" x:Uid="MenuPageIndicatorToggle" Text="Show Page Count" Click="MenuPageIndicatorToggle_Click" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="MenuViewSingle" x:FieldModifier="internal" x:Uid="MenuViewMode_Single" Text="Single" Click="MenuViewMode_Click" Tag="1" />
                    <ToggleMenuFlyoutItem x:Name="MenuViewDouble" x:FieldModifier="internal" x:Uid="MenuViewMode_Double" Text="Manga (2-split)" Click="MenuViewMode_Click" Tag="2" />
                    <ToggleMenuFlyoutItem x:Name="MenuViewQuad" x:FieldModifier="internal" x:Uid="MenuViewMode_Quad" Text="Quad (4-split)" Click="MenuViewMode_Click" Tag="4" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="MenuStretchContain" x:FieldModifier="internal" x:Uid="MenuStretchContain" Text="Contain (Uniform)" Click="MenuStretchMode_Click" Tag="2" />
                    <ToggleMenuFlyoutItem x:Name="MenuStretchCover" x:FieldModifier="internal" x:Uid="MenuStretchCover" Text="Cover (UniformToFill)" Click="MenuStretchMode_Click" Tag="3" />
                    <ToggleMenuFlyoutItem x:Name="MenuStretchOriginal" x:FieldModifier="internal" x:Uid="MenuStretchOriginal" Text="Original Size (None)" Click="MenuStretchMode_Click" Tag="0" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MenuQuadLayout" x:FieldModifier="internal" x:Uid="MenuQuadLayout" Text="Quad Layout">
                    <ToggleMenuFlyoutItem x:Name="MenuLayoutAuto" x:FieldModifier="internal" x:Uid="MenuLayoutAuto" Text="Auto (Aspect Ratio)" Click="MenuLayoutMode_Click" Tag="0" />
                    <ToggleMenuFlyoutItem x:Name="MenuLayoutHorz" x:FieldModifier="internal" x:Uid="MenuLayoutHorz" Text="Horizontal (1x4)" Click="MenuLayoutMode_Click" Tag="1" />
                    <ToggleMenuFlyoutItem x:Name="MenuLayoutGrid" x:FieldModifier="internal" x:Uid="MenuLayoutGrid" Text="Grid (2x2)" Click="MenuLayoutMode_Click" Tag="2" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuSlideshow" x:FieldModifier="internal" x:Uid="MenuSlideshow" Text="Slideshow" Click="MenuSlideshow_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuSettings" x:FieldModifier="internal" x:Uid="MenuSettings" Text="General Settings..." Click="MenuSettings_Click" />
                <MenuFlyoutItem x:Name="MenuKeyBindings" x:FieldModifier="internal" x:Uid="MenuKeyBindings" Text="Key Bindings Settings..." Click="MenuKeyBindings_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuSupport" x:FieldModifier="internal" x:Uid="MenuSupport" Text="Support" Click="MenuSupport_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" x:FieldModifier="internal" Grid.Row="0" Height="32" Background="#242424" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <TextBlock x:Uid="AppTitleBar_Text" Text="Quick Image Viewer" Foreground="#888888" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Border>

        <Grid Grid.Row="1">
            <controls:ViewerPanel x:Name="ViewerControlInternal" x:FieldModifier="internal" Visibility="{x:Bind BoolToVis(ViewModel.IsViewerMode), Mode=OneWay}" />
            <controls:GridImagePanel x:Name="GridControlInternal" x:FieldModifier="internal" Visibility="{x:Bind BoolToVis(ViewModel.IsGridMode), Mode=OneWay}" />

            <Grid x:Name="OverlayGrid" x:FieldModifier="internal" IsHitTestVisible="True">

                <!-- Metadata Overlay Panel -->
                <Border x:Name="MetadataPanel" x:FieldModifier="internal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        Background="#CC000000" CornerRadius="8" Padding="16"
                        Visibility="Collapsed" MaxWidth="350" IsHitTestVisible="True">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TxtMetaTitle" x:FieldModifier="internal" x:Uid="TxtMetaTitle" Text="IMAGE INFORMATION" FontSize="10" Foreground="#888888" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtMetaFileName" x:FieldModifier="internal" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtMetaDimensions" x:FieldModifier="internal" Foreground="#00A2ED" FontSize="12"/>
                        <TextBlock x:Name="TxtMetaFileSize" x:FieldModifier="internal" Foreground="#AAAAAA" FontSize="12"/>

                        <Border x:Name="ExifDivider" x:FieldModifier="internal" Height="1" Background="#333333" Margin="0,8"/>

                        <Grid x:Name="ExifGrid" x:FieldModifier="internal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="TxtMetaCameraLabel" Text="Camera" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                            <TextBlock x:Name="TxtMetaCamera" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="11" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="TxtMetaLensLabel" Text="Lens" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                            <TextBlock x:Name="TxtMetaLens" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="TxtMetaSettingsLabel" Text="Settings" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                            <TextBlock x:Name="TxtMetaSettings" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1" Foreground="#FFD700" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="TxtMetaDateLabel" Text="Date" FontSize="11" Foreground="#888888" Margin="0,0,12,2"/>
                            <TextBlock x:Name="TxtMetaDate" x:FieldModifier="internal" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- Bookmark Panel (Overlay) -->
        <Border x:Name="BookmarkPanel" x:FieldModifier="internal"
                Grid.Row="1" HorizontalAlignment="Left" Width="280"
                Background="#EE1F1F1F" BorderBrush="#333333" BorderThickness="0,0,1,0"
                Visibility="Collapsed" Canvas.ZIndex="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="16">
                    <TextBlock x:Uid="BookmarkPanel_Title" Text="BOOKMARKS" FontSize="12" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{ThemeResource SubtleButtonStyle}" Click="MenuBookmarkPanel_Close_Click">
                        <FontIcon Glyph="&#xE894;" FontSize="14"/>
                    </Button>
                </Grid>
                <ListView x:Name="BookmarkListView" x:FieldModifier="internal" Grid.Row="1" Padding="0,0,0,16" 
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="BookmarkListView_ItemClick"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="BookmarkListView_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="managers:BookmarkItem">
                            <Grid Padding="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xED41;" FontSize="16" Foreground="#FFD700" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Path}" Foreground="#666666" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Style="{ThemeResource SubtleButtonStyle}" Tag="{x:Bind Path}" Click="MenuBookmarkRemove_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#666666"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        
        <!-- Folder Searching Overlay -->
            <Border x:Name="FolderSearchingOverlay" x:FieldModifier="internal" Grid.Row="1" Background="#88000000" 
                    Visibility="{x:Bind GetSearchingOverlayVisibility(ViewModel.IsSearchingFolder, ViewModel.IsSlideshowRunning), Mode=OneWay}" 
                    IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150" Spacing="12">
                    <ProgressRing IsActive="True" Width="64" Height="64" Foreground="#00A2ED" />
                    <TextBlock x:Uid="SearchingText" Text="Searching for images..." Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Notification Overlay -->
            <Border x:Name="NotificationOverlay" x:FieldModifier="internal" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80" Padding="40,24" Background="#CC000000" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="1000">
                <TextBlock x:Name="NotificationText" x:FieldModifier="internal" Foreground="White" FontSize="36" FontWeight="Bold" />
            </Border>

            <!-- Page Indicator -->
            <Border x:Name="PageIndicatorContainer" x:FieldModifier="internal"
                       Grid.Row="1"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="12" Padding="8,4"
                       Background="#66000000" CornerRadius="4"
                       Visibility="{x:Bind BoolToVis(ViewModel.IsPageIndicatorVisible), Mode=OneWay}"
                       IsHitTestVisible="False"
                       Canvas.ZIndex="100">
                <TextBlock x:Name="PageIndicator" x:FieldModifier="internal"
                           Text="{x:Bind ViewModel.PageIndicatorText, Mode=OneWay}"
                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>
        
        <ContentDialog x:Name="SlideshowDialog" x:FieldModifier="internal" x:Uid="SlideshowDialog"
                       Title="自動再生設定"
                       PrimaryButtonText="OK"
                       CloseButtonText="キャンセル"
                       DefaultButton="Primary"
                       PrimaryButtonClick="SlideshowDialog_PrimaryButtonClick"
                       Opened="SlideshowDialog_Opened">
            <StackPanel Spacing="12">
                <CheckBox x:Name="SlideshowFullscreen" x:FieldModifier="internal" x:Uid="SlideshowFullscreen" Content="全画面表示(_F)" AccessKey="F" IsChecked="{x:Bind ViewModel.SlideshowFullscreen, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowRandom" x:FieldModifier="internal" x:Uid="SlideshowRandom" Content="ランダムな並び順(_R)" AccessKey="R" IsChecked="{x:Bind ViewModel.SlideshowRandom, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowLoop" x:FieldModifier="internal" x:Uid="SlideshowLoop" Content="ループする(_L)" AccessKey="L" IsChecked="{x:Bind ViewModel.SlideshowLoop, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowNextFolder" x:FieldModifier="internal" x:Uid="SlideshowNextFolder" Content="次のフォルダも表示(_N)" AccessKey="N" IsChecked="{x:Bind ViewModel.SlideshowNextFolder, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowIncludeSiblings" x:FieldModifier="internal" x:Uid="SlideshowIncludeSiblings" Content="兄弟フォルダも含める(_S)" AccessKey="S" IsChecked="{x:Bind ViewModel.SlideshowIncludeSiblings, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowCurrentFolderOnly" x:FieldModifier="internal" x:Uid="SlideshowCurrentFolderOnly" Content="下位フォルダも含める(_B)" AccessKey="B" IsChecked="{x:Bind ViewModel.SlideshowCurrentFolderOnly, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowUniformToFill" x:FieldModifier="internal" x:Uid="SlideshowUniformToFill" Content="拡大して全体を埋める(_C)" AccessKey="C" IsChecked="{x:Bind ViewModel.SlideshowUniformToFill, Mode=TwoWay}"/>
                <CheckBox x:Name="SlideshowCrossfade" x:FieldModifier="internal" x:Uid="SlideshowCrossfade" Content="クロスフェードを有効にする" IsChecked="{x:Bind ViewModel.SlideshowCrossfade, Mode=TwoWay}"/>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SlideshowIntervalLabel" Text="時間(_T)：" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" x:Name="SlideshowInterval" x:FieldModifier="internal" SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1.0" Minimum="0.1" Margin="4,0" HorizontalAlignment="Left" Width="240" AccessKey="T" Value="{x:Bind ViewModel.SlideshowInterval, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" x:Uid="SlideshowIntervalUnit" Text="秒毎" VerticalAlignment="Center" Width="40"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SlideshowCrossfadeDurationLabel" Text="フェード時間：" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" x:Name="SlideshowCrossfadeDuration" x:FieldModifier="internal" SpinButtonPlacementMode="Inline" SmallChange="0.05" LargeChange="0.1" Minimum="0" Maximum="5" Margin="4,0" HorizontalAlignment="Left" Width="240" Value="{x:Bind ViewModel.SlideshowCrossfadeDuration, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" x:Uid="SlideshowCrossfadeDurationUnit" Text="秒" VerticalAlignment="Center" Width="40"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>