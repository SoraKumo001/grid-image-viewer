<UserControl
    x:Class="grid_image_viewer.Controls.KeyBindingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RequestedTheme="Dark"
    KeyDown="Overlay_KeyDown">

    <Grid Background="#CC000000">
        <Border
            Background="#FF202020"
            CornerRadius="12"
            BorderBrush="#FF404040"
            BorderThickness="1"
            Width="480"
            MaxHeight="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock x:Uid="KeyBinding_Title" Text="Key Bindings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="White" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                    <StackPanel x:Name="BindingsStack" Spacing="8">
                        <!-- Items will be added here or bound -->
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Button x:Uid="KeyBinding_ResetAll" Content="Reset All" HorizontalAlignment="Left" Click="BtnResetAll_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="KeyBinding_Cancel" Content="Cancel" Width="100" Click="BtnCancel_Click" />
                        <Button x:Uid="KeyBinding_Save" Content="Save" Width="100" Style="{StaticResource AccentButtonStyle}" Click="BtnSave_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
