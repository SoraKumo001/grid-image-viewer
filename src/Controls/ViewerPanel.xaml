<UserControl
    x:Class="grid_image_viewer.Controls.ViewerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:grid_image_viewer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ImageScrollViewer"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Hidden"
        ZoomMode="Enabled"
        MinZoomFactor="0.1"
        MaxZoomFactor="10.0">
        <Grid x:Name="PagesGrid"
              Width="{Binding ElementName=ImageScrollViewer, Path=ViewportWidth}"
              Height="{Binding ElementName=ImageScrollViewer, Path=ViewportHeight}"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="Col0" />
                <ColumnDefinition Width="*" x:Name="Col1" />
                <ColumnDefinition Width="*" x:Name="Col2" />
                <ColumnDefinition Width="*" x:Name="Col3" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" x:Name="Row0" />
                <RowDefinition Height="*" x:Name="Row1" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageGrid4" Visibility="Collapsed">
                <Grid x:Name="PrevContainer4" IsHitTestVisible="False">
                    <Image x:Name="Image4_Prev" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="CurrentContainer4">
                    <Image x:Name="Image4" Stretch="Uniform" />
                    <skia:SKXamlCanvas x:Name="Canvas4" Visibility="Collapsed" />
                </Grid>
                <ProgressRing x:Name="LoadingRing4" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                <Border x:Name="FocusBorder4" BorderBrush="#00A2ED" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="PageGrid3" Visibility="Collapsed">
                <Grid x:Name="PrevContainer3" IsHitTestVisible="False">
                    <Image x:Name="Image3_Prev" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="CurrentContainer3">
                    <Image x:Name="Image3" Stretch="Uniform" />
                    <skia:SKXamlCanvas x:Name="Canvas3" Visibility="Collapsed" />
                </Grid>
                <ProgressRing x:Name="LoadingRing3" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                <Border x:Name="FocusBorder3" BorderBrush="#00A2ED" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="PageGrid2" Visibility="Collapsed">
                <Grid x:Name="PrevContainer2" IsHitTestVisible="False">
                    <Image x:Name="Image2_Prev" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="CurrentContainer2">
                    <Image x:Name="Image2" Stretch="Uniform" />
                    <skia:SKXamlCanvas x:Name="Canvas2" Visibility="Collapsed" />
                </Grid>
                <ProgressRing x:Name="LoadingRing2" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                <Border x:Name="FocusBorder2" BorderBrush="#00A2ED" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <Grid x:Name="PageGrid1" Visibility="Collapsed">
                <Grid x:Name="PrevContainer1" IsHitTestVisible="False">
                    <Image x:Name="Image1_Prev" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="CurrentContainer1">
                    <Image x:Name="Image1" Stretch="Uniform" />
                    <skia:SKXamlCanvas x:Name="Canvas1" Visibility="Collapsed" />
                </Grid>
                <ProgressRing x:Name="LoadingRing1" Width="40" Height="40" Foreground="#00A2ED" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="False" />
                <Border x:Name="FocusBorder1" BorderBrush="#00A2ED" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            
            <Grid Grid.ColumnSpan="4" Grid.RowSpan="2" x:Name="OverlayGrid" Background="Transparent" IsHitTestVisible="True" />
        </Grid>
    </ScrollViewer>
</UserControl>